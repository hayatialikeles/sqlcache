# Template for sqlcache settings. Copy it to .env in your app's working directory
# (in an installed project: cp node_modules/sqlcache/.env.example .env).
# Only .env is loaded, and ${VAR} references are not expanded.

# ============================================
# MySQL Database Configuration (REQUIRED)
# ============================================

# MySQL server hostname or IP address
DB_HOST=localhost

# MySQL server port (default: 3306)
DB_PORT=3306

# Database username
DB_USERNAME=root

# Database password (leave empty if no password)
DB_PASSWORD=

# Default database name to connect to
DB_NAME=my_database

# ============================================
# Connection Pool Settings (OPTIONAL)
# ============================================

# Maximum number of connections in the pool, per process (default: 151)
# Keep instances x workers x DB_CONNECTION_LIMIT, plus other clients, below MySQL's
# max_connections (MySQL's default is also 151)
DB_CONNECTION_LIMIT=151

# Maximum number of queued connection requests (default: 0 = unlimited)
# 0 = unlimited queue (recommended - waits when pool is full)
# Set to prevent memory issues during traffic spikes
DB_QUEUE_LIMIT=0

# Maximum number of idle connections to maintain in pool (default: 10)
# MySQL2 recommended value - helps manage connection lifecycle
# With bursty traffic, connections above this are closed after DB_IDLE_TIMEOUT and reopened on
# the next burst; raise it (up to DB_CONNECTION_LIMIT) to keep them warm
DB_MAX_IDLE=10

# Idle connection timeout in milliseconds (default: 60000)
# Connections idle longer than this will be closed (60 seconds)
DB_IDLE_TIMEOUT=60000

# Connection timeout in milliseconds (default: 10000)
# Time to wait for initial database connection before throwing error
DB_CONNECT_TIMEOUT=10000

# Allow multiple SQL statements in a single query (default when unset: true, for backward
# compatibility). false is recommended for new projects: with true, an SQL injection can run
# additional statements. Set true only if you send several statements in one query.
DB_MULTIPLE_STATEMENTS=false

# Concurrent cache misses for the same key, database, SQL and parameters share one
# database query; each caller still gets its own copy of the rows (default: true)
# DB_COALESCE_QUERIES=true

# Max time (ms) a caller waits for such a shared query before running its own, which protects
# against a stuck connection; it still takes the shared result if that arrives first (default: 10000)
# DB_COALESCE_MAX_WAIT=10000

# getCacheQueryPagination: reuse the COUNT(*) total of one page for the other pages of the same
# query until its cache name is invalidated, instead of counting on every page miss. Totals can
# then lag behind writes that do not invalidate the cache name (default: false)
# DB_PAGINATION_REUSE_TOTAL=false

# ============================================
# Redis Cache Configuration (OPTIONAL)
# ============================================

# Enable Redis caching (default: true)
# Set to 'false' to disable caching completely
REDIS_ENABLED=true

# Redis server hostname or IP address
REDIS_SERVER=localhost

# Redis port (default: 6379)
REDIS_PORT=6379

# Redis password (leave empty if no password)
# Cached rows are served as stored, so treat Redis as a trusted store: use AUTH and a private network
REDIS_PASSWORD=

# Redis virtual host / namespace prefix
# All cache keys will be prefixed with this value and a colon
# Useful to separate applications or environments that share one Redis
# Set it once per process; do not change it at runtime (for example per tenant request)
# Example: REDIS_VHOST=app1 will create keys like "app1:users-cache"
REDIS_VHOST=

# ============================================
# Redis Resilience & Performance (OPTIONAL)
# ============================================

# Max time (ms) a cache operation waits for Redis to (re)connect before falling back (default: 10000)
# REDIS_WAIT_TIMEOUT=10000

# Once Redis has been unavailable for REDIS_WAIT_TIMEOUT, cache reads/writes return their
# fallback immediately instead of each waiting again (default: true). Deletes always wait.
# REDIS_FAIL_FAST=true

# Max time (ms) a cache read/write command may stay unanswered, e.g. during a network
# partition, before it falls back; a connection that gives no reply at all for this long is
# reconnected. Deletes are never cut short. (default: the larger of REDIS_WAIT_TIMEOUT and
# 10000; 0 = disabled)
# REDIS_COMMAND_TIMEOUT=10000

# Max delay (ms) between reconnect attempts. It also bounds how long the app keeps running
# without cache after Redis is back (default: 5000; was 30000 before v2.9.0)
# REDIS_RECONNECT_MAX_DELAY=5000

# Keys examined per SCAN round trip when deleting by prefix (default: 1000; was 100 before v2.9.0)
# REDIS_SCAN_COUNT=1000

# ============================================
# Timezone Configuration (OPTIONAL)
# ============================================

# MySQL timezone offset (default: +00:00 UTC)
# Examples: +03:00 (Istanbul), -05:00 (New York), +00:00 (UTC)
TIMEZONE=+00:00

# ============================================
# v2.6.0 Smart Features (OPTIONAL) 🚀
# ============================================

# Automatic cache keys: generate a cache key when cacheName is omitted
# This enables auto keys only, NOT auto invalidation (set CORE_AUTO_INVALIDATION for that)
CORE_AUTO_FEATURES=false

# Automatic invalidation: after INSERT/UPDATE/DELETE/REPLACE (and, since 2.9.1, bulkInsert)
# without a resetCacheName, delete the table's <table>_* and <table>:* keys
CORE_AUTO_INVALIDATION=false

# ============================================
# Example Configurations for Different Environments
# ============================================

# Development Environment:
# DB_HOST=localhost
# DB_USERNAME=root
# DB_PASSWORD=
# REDIS_SERVER=localhost

# Production Environment (High Traffic - 1000+ concurrent users):
# DB_HOST=mysql-prod.example.com
# DB_USERNAME=prod_user
# DB_PASSWORD=strong_password_here
# DB_CONNECTION_LIMIT=50                  # Per process: instances x workers x limit < max_connections
# DB_QUEUE_LIMIT=0                        # Unlimited queue (recommended)
# DB_CONNECT_TIMEOUT=10000                # 10 seconds
# DB_MULTIPLE_STATEMENTS=false
# REDIS_SERVER=redis-prod.example.com
# REDIS_PASSWORD=redis_password_here
# REDIS_VHOST=prod
# CORE_AUTO_FEATURES=true                 # Automatic cache keys
# CORE_AUTO_INVALIDATION=true             # Automatic invalidation

# Docker Environment:
# DB_HOST=mysql
# DB_USERNAME=app_user
# DB_PASSWORD=app_password
# REDIS_SERVER=redis
